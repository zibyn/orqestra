# Used by docker compose. For local development copy this to .env.local instead and set DATABASE_URL.

# PostgreSQL password for the bundled postgres service (docker compose builds DATABASE_URL from it)
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgres://user:password@localhost:5432/orqestra

# Object storage for Attachments, any S3-compatible service; the api and worker do not start without it.
# docker compose runs RustFS with these keys and creates the bucket; leave S3_ENDPOINT unset to use it.
# S3_ENDPOINT=http://localhost:9000
S3_BUCKET=orqestra
S3_ACCESS_KEY_ID=orqestra
S3_SECRET_ACCESS_KEY=change-me
# S3_REGION=us-east-1

# Encrypts Provider API keys in the database; changing it makes stored keys unreadable. openssl rand -base64 32
ORQESTRA_ENCRYPTION_KEY=

# Where Orqestra is served, no trailing slash. Polaris redirects back to {ORQESTRA_URL}/auth/callback,
# and signs out back to {ORQESTRA_URL}: register both on the Application exactly like this
ORQESTRA_URL=http://localhost:3000

# The Polaris instance, e.g. https://auth.example.com
POLARIS_ISSUER=

# The Web Application at Polaris (client_secret_basic, refresh tokens on)
POLARIS_CLIENT_ID=
POLARIS_CLIENT_SECRET=

# The access tokens' aud: identifier of Orqestra's API at Polaris, set as the Application's default API;
# Admins hold its orqestra:admin Permission through a Role
POLARIS_AUDIENCE=orqestra

# Encrypts the session cookie; changing it signs everyone out. openssl rand -base64 32
POLARIS_SECRET=

# Optional: Web Push Alerts, all three or none (needs HTTPS). Keys from npx web-push generate-vapid-keys;
# the subject is a mailto: or https:// contact for the push services
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Optional worker tuning (positive integers)
# WORKER_CONCURRENCY=
# SUBAGENT_CONCURRENCY=
# PROVIDER_CONCURRENCY=

# Optional: Run traces over OTLP/HTTP (protobuf only) to your backend; nothing is sent while both endpoints are unset
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20...
# OTEL_SERVICE_NAME=orqestra-worker
